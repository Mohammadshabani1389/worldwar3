BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
DATABASE_URL=sqlite:///database/worldwar3.db

# Telegram numeric ID of the permanent Owner
OWNER_ID=123456789


# Payment callback endpoint (technical server setting; Owner does not configure this in the bot panel)
# Must be a public HTTPS base URL that can reach the bot server.
ZARINPAL_CALLBACK_BASE_URL=https://example.com
# Optional shared public HTTPS base URL for CoinPayments webhook.
# Leave blank if you do not have a public HTTPS endpoint; polling fallback still works.
PAYMENT_WEB_BASE_URL=https://example.com
PAYMENT_WEB_HOST=0.0.0.0
PAYMENT_WEB_PORT=8080
